/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# El código y las imágenes de fachada tienen nombre fijo, de modo que sin esta
# regla el navegador puede seguir usando una versión antigua después de publicar
# un cambio. Con la revalidación pregunta si el archivo cambió y recibe un 304
# de unos pocos bytes cuando no es así: se nota el cambio de inmediato y casi no
# cuesta. Las señaléticas y las figuras del manual no llevan esta regla porque
# son cientos de archivos que nunca cambian.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/senales/*
  Cache-Control: public, max-age=604800

/assets/manual/*
  Cache-Control: public, max-age=604800

/assets/marca/*
  Cache-Control: public, max-age=604800

/datos/*
  Cache-Control: public, max-age=3600
